{
  "name": "@muchobien/brisa",
  "version": "0.1.0",
  "private": true,
  "description": "A quieter home for your notifications. Self-hosted Web Push on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muchobien/brisa.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply brisa --local",
    "db:migrate:remote": "wrangler d1 migrations apply brisa --remote --config wrangler.deploy.jsonc",
    "demo:seed": "wrangler d1 execute brisa --local --file scripts/demo.sql",
    "typegen": "wrangler types",
    "typecheck": "tsc -b",
    "check": "vp check",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && vp build",
    "preview": "vp preview",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/icons.mjs",
    "pretest": "wrangler deploy --config wrangler.jsonc --dry-run --assets public --outdir artifacts/test-worker",
    "test:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "3.6.7",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "5.20261012.0-beta",
    "sharp": "0.35.5",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "1.2.0",
    "wrangler": "4.151.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
